{
  "name": "blog-application",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:test": "concurrently \"npm run dev --workspace=client\" \"npm run start:test --workspace=server\"",
    "build": "npm run build --workspace=client && shx rm -rf server/dist && shx cp -r client/dist server",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "test:e2e:ui": "cross-env NODE_ENV=test playwright test --ui",
    "lint": "npm run lint --workspaces --if-present && eslint e2e-test",
    "lint:fix": "npm run lint:fix --workspace=client && npm run lint:fix --workspace=server && eslint e2e-test --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "shx": "^0.3.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.25.12": true
  }
}
